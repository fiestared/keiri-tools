    "height": 900,
    "issues": [],
    "headings": [
      {
        "text": "法定調書合計表とは（6つの調書の集計表）",
        "id": "towa"
      },
      {
        "text": "通常の提出期限は1月31日（令和8年分は2月1日）",
        "id": "kigen"
      },
      {
        "text": "【令和8年分から】源泉徴収票の「みなし提出の特例」",
        "id": "kaisei"
      },
      {
        "text": "提出範囲——誰の分を税務署に出すのか",
        "id": "hanni"
      },
      {
        "text": "税務署・市区町村・本人の3系統を整理する",
        "id": "sankei"
      },
      {
        "text": "e-Tax等での提出義務（100枚以上→30枚以上）",
        "id": "etax"
      },
      {
        "text": "合計表の書き方（Ⓐ・Ⓑの2段構造）",
        "id": "kakikata"
      },
      {
        "text": "出さなかったらどうなるか／訂正のしかた",
        "id": "batsu"
      },
      {
        "text": "よくある質問",
        "id": "faq"
      },
      {
        "text": "関連記事・ツール",
        "id": ""
      },
      {
        "text": "次に読む",
        "id": ""
      },
