{"attached_files_info":null,"law_info":{"law_type":"Act","law_id":"337AC0000000066","law_num":"昭和三十七年法律第六十六号","law_num_era":"Showa","law_num_year":37,"law_num_type":"Act","law_num_num":"066","promulgation_date":"1962-04-02"},"revision_info":{"law_revision_id":"337AC0000000066_20260624_508AC0000000046","law_type":"Act","law_title":"国税通則法","law_title_kana":"こくぜいつうそくほう","abbrev":"","category":"国税","updated":"2026-07-01T10:40:22+09:00","amendment_promulgate_date":"2026-06-24","amendment_enforcement_date":"2026-06-24","amendment_enforcement_comment":null,"amendment_scheduled_enforcement_date":null,"amendment_law_id":"508AC0000000046","amendment_law_title":"民法等の一部を改正する法律の施行に伴う関係法律の整備等に関する法律","amendment_law_title_kana":null,"amendment_law_num":"令和八年法律第四十六号","amendment_type":"3","repeal_status":"None","repeal_date":null,"remain_in_force":false,"mission":"New","current_revision_status":"CurrentEnforced"},"law_full_text":{"tag":"Article","attr":{"Num":"10"},"children":[{"tag":"ArticleCaption","attr":{},"children":["（期間の計算及び期限の特例）"]},{"tag":"ArticleTitle","attr":{},"children":["第十条"]},{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["国税に関する法律において日、月又は年をもつて定める期間の計算は、次に定めるところによる。"]}]},{"tag":"Item","attr":{"Num":"1"},"children":[{"tag":"ItemTitle","attr":{},"children":["一"]},{"tag":"ItemSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Function":"main","Num":"1","WritingMode":"vertical"},"children":["期間の初日は、算入しない。"]},{"tag":"Sentence","attr":{"Function":"proviso","Num":"2","WritingMode":"vertical"},"children":["ただし、その期間が午前零時から始まるとき、又は国税に関する法律に別段の定めがあるときは、この限りでない。"]}]}]},{"tag":"Item","attr":{"Num":"2"},"children":[{"tag":"ItemTitle","attr":{},"children":["二"]},{"tag":"ItemSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["期間を定めるのに月又は年をもつてしたときは、暦に従う。"]}]}]},{"tag":"Item","attr":{"Num":"3"},"children":[{"tag":"ItemTitle","attr":{},"children":["三"]},{"tag":"ItemSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Function":"main","Num":"1","WritingMode":"vertical"},"children":["前号の場合において、月又は年の始めから期間を起算しないときは、その期間は、最後の月又は年においてその起算日に応当する日の前日に満了する。"]},{"tag":"Sentence","attr":{"Function":"proviso","Num":"2","WritingMode":"vertical"},"children":["ただし、最後の月にその応当する日がないときは、その月の末日に満了する。"]}]}]}]},{"tag":"Paragraph","attr":{"Num":"2"},"children":[{"tag":"ParagraphNum","attr":{},"children":["２"]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["国税に関する法律に定める申告、申請、請求、届出その他書類の提出、通知、納付又は徴収に関する期限（時をもつて定める期限その他の政令で定める期限を除く。）が日曜日、国民の祝日に関する法律（昭和二十三年法律第百七十八号）に規定する休日その他一般の休日又は政令で定める日に当たるときは、これらの日の翌日をもつてその期限とみなす。"]}]}]}]}}