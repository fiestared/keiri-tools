    "text_hash": "c21fb642b562b155d926",
    "element_id": null
  },
  {
    "id": "s-f6f476a2618114be082b-2",
    "page": "docs/column/furikomi-tesuryo-hikaku/index.html",
    "kind": "td",
    "zone": "table",
    "protected": true,
