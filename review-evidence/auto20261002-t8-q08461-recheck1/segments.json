    "element_id": null
  },
  {
    "id": "s-321e41212cdf66262f0a-2",
    "page": "docs/column/furikomi-tesuryo-hikaku/index.html",
    "kind": "td",
    "zone": "table",
    "protected": true,
    "text": "【行】福岡銀行（個人IB） 【列】3万円未満 【値】220円福岡・熊本・十八親和・福岡中央・みんなの銀行あては無料",
    "text_hash": "ca1f61d07e114f492092",
    "element_id": null
  },
  {
    "id": "s-a94ff593a0faaa7f50da-2",
    "page": "docs/column/furikomi-tesuryo-hikaku/index.html",
    "kind": "td",
    "zone": "table",
    "protected": true,
