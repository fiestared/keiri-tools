  "results": [
    {
      "path": "/column/gasolindai-kanjo-kamoku/",
      "width": 1280,
      "height": 900,
      "issues": [],
      "headings": [
        {
          "text": "4つの科目は、何をまとめて管理するかで使い分ける",
          "id": "accounts"
        },
        {
          "text": "仕訳は、税込経理・税抜経理と支払方法を揃える",
          "id": "journal"
        },
        {
          "text": "個人事業主のマイカーは、業務分を記録から分ける",
          "id": "private"
        },
        {
          "text": "ガソリン税にも消費税がかかるのは、販売価格の一部だから",
          "id": "tax"
        },
        {
          "text": "軽油引取税が消費税の対象外になるには、二つの確認が要る",
          "id": "diesel"
        },
        {
          "text": "ガソリン代の仕入税額控除は、原則としてインボイスと帳簿の保存が要件（少額特例などの例外あり）",
          "id": "invoice"
        },
        {
          "text": "従業員への出張精算は、通常必要な範囲かを確認する",
          "id": "reimburse"
        },
        {
          "text": "通勤のガソリン代：令和8年4月1日以後に受けるべき手当は改正後の限度額（同日前分の差額追給を除く）",
          "id": "commute"
        },
        {
          "text": "給与課税された通勤手当でも、消費税は別に判定する",
          "id": "different"
        },
        {
          "text": "よくある質問",
          "id": "faq"
        },
        {
          "text": "次に読む",
          "id": ""
        },
        {
          "text": "関連記事・ツール",
          "id": "related"
        },
        {
          "text": "出典",
          "id": "shutten"
        }
      ],
