[
  {
    "url": "/column/kani-kazei/",
    "width": 1280,
    "height": 900,
    "issues": [],
    "headings": [
      {
        "text": "簡易課税とは（売上だけで納税額が決まる）",
        "id": "shikumi"
      },
      {
        "text": "みなし仕入率の全業種一覧（第1種〜第6種）",
        "id": "minashi"
      },
      {
        "text": "事業区分の落とし穴（間違えると納税額が数倍変わる）",
        "id": "jigyokubun"
      },
      {
        "text": "本則・簡易・2割特例・3割特例を実数で比較",
        "id": "hikaku"
      },
      {
        "text": "2割特例が終わったあと、何を選ぶか",
        "id": "nochi"
      },
      {
        "text": "届出の期限（ここでミスすると1年損する）",
        "id": "todokede"
      },
      {
        "text": "メリット・デメリットを正直に",
        "id": "merit"
      },
      {
        "text": "今すぐやるべきこと",
        "id": "ima"
      },
      {
        "text": "よくある質問",
        "id": "faq"
      },
      {
        "text": "次に読む",
        "id": ""
      },
      {
        "text": "関連記事・ツール",
        "id": ""
      },
      {
        "text": "出典",
        "id": ""
