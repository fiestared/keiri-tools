      "headings": [
        {
          "text": "なぜ原則として違法なのか（通達の中身）",
          "id": "gensoku"
        },
        {
          "text": "買取が認められる3つの例外",
          "id": "reigai"
        },
        {
          "text": "退職時の買取 ― 適法だが「義務」ではない",
          "id": "taishoku"
        },
        {
          "text": "買取価格の相場と決め方",
          "id": "soba"
        },
        {
          "text": "買取金の税金・社会保険料はどうなるか",
          "id": "zeikin"
        },
        {
          "text": "消化するのと買い取ってもらうのは、どちらが得か",
          "id": "shokahikaku"
        },
