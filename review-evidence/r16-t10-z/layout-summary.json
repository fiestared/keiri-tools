      "headings": [
        {
          "text": "「出金伝票」という語は、日本の法令に一度も出てこない",
          "id": "zero"
        },
        {
          "text": "三伝票制を条文で定めている唯一の例は、「入金・出金」と呼んでいない",
          "id": "kyosai"
        },
        {
          "text": "出金伝票の区分は使い方による。領収書は「書類」の列",
          "id": "gou"
        },
        {
          "text": "伝票で記帳に代えると「帳簿代用書類」になり、緩和から外れる",
          "id": "daiyo"
        },
        {
          "text": "自分で作った書類が「請求書等」になる道は、条文上1本だけ",
          "id": "kakunin"
        },
        {
          "text": "「3万円未満なら領収書は要らない」は2023年9月30日で終わっている",
          "id": "sanman"
        },
        {
          "text": "施行令49条の4類型と追加記載事項（少額特例とは別）",
          "id": "yonruikei"
        },
        {
          "text": "手書きの出金伝票は、スキャンして原本を捨てられない",
          "id": "scan"
        },
        {
          "text": "保存期間の起算日は、伝票を書いた日ではない",
          "id": "hozon"
        },
        {
          "text": "記入例 — 自動販売機・慶弔金・立替精算",
          "id": "rei"
        },
        {
          "text": "よくある質問",
          "id": "faq"
        },
        {
          "text": "次に読む",
          "id": ""
        },
        {
          "text": "出典",
          "id": ""
        }
      ],
