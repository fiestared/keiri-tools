    "text_hash": "a81f673b56c9d0ed07a6",
    "element_id": null
  },
  {
    "id": "s-f06aad7b3bbefcb69611-1",
    "page": "docs/shiharai-site/index.html",
    "kind": "label",
    "zone": "ui",
    "protected": false,
    "text": "支払日が土日祝のとき",
    "text_hash": "1ecc847bbdc2017a3c19",
    "element_id": null
  },
  {
    "id": "s-ada7c5442ebae6cfd9cd-1",
    "page": "docs/shiharai-site/index.html",
    "kind": "label",
    "zone": "ui",
    "protected": false,
    "text": "前営業日に前倒し",
    "text_hash": "e56feba40064de905015",
    "element_id": null
  },
  {
    "id": "s-66413fbca0e15c4b87f6-1",
    "page": "docs/shiharai-site/index.html",
    "kind": "input",
    "zone": "ui",
    "protected": false,
    "text": "adjust: true; placeholder=; min=; max=; step=",
