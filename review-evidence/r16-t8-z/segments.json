    "kind": "label",
    "zone": "ui",
    "protected": false,
    "text": "調整しない",
    "text_hash": "1a8bf0bd052ce0e76544",
    "element_id": null
  },
  {
    "id": "s-4115817678c53ee0fef1-2",
