      "page": "docs/shiharai-site/index.html",
      "kind": "h3",
      "zone": "faq",
      "protected": false,
      "text": "支払日が土日祝のときは？",
      "text_hash": "696bd53d819c0ea28b71",
      "element_id": "faq-q3",
      "result": "nonclaim",
      "claim_id": null,
