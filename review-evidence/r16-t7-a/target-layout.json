[
  {
    "url": "/column/koyou-hoken-kanyu-joken/",
    "width": 1280,
    "issues": [],
    "headings": [
      {
        "text": "2つの条件を、条文の書き方どおりに読む",
        "id": "joken"
      },
      {
        "text": "除外リストは6号ある — 季節・漁船・公務員",
        "id": "jogai"
      },
      {
        "text": "加入は本人の希望でも、会社の裁量でもない",
        "id": "kyosei"
      },
      {
        "text": "学生の例外 — 条文は「学生だから除外」とは書いていない",
        "id": "gakusei"
      },
      {
        "text": "掛け持ちは合算しない（65歳以上だけ例外）",
        "id": "kakemochi"
      },
      {
        "text": "加入したあと、4つの類型のどれになるか",
        "id": "ruikei"
      },
      {
        "text": "一般の資格取得届は会社が翌月10日までに提出 — 日雇は本人が5日以内",
        "id": "tetsuduki"
      },
      {
        "text": "雇用保険に入っているかを確認する方法",
        "id": "kakunin"
      },
      {
        "text": "入っていなかったとき — 遡れるのは原則2年",
        "id": "sokyu"
      },
      {
        "text": "2028年10月、週20時間が週10時間になる",
        "id": "kaisei"
      },
      {
        "text": "まとめ",
        "id": "matome"
      },
      {
        "text": "よくある質問",
        "id": "faq"
      },
      {
        "text": "関連するツール・記事",
        "id": "related"
      },
      {
        "text": "次に読む",
        "id": ""
      },
      {
        "text": "出典",
        "id": "sources"
      },
      {
        "text": "会社側で確認したい支援制度",
        "id": ""
      }
    ],
