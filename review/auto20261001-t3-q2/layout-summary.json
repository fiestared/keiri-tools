      "headings": [
        {
          "text": "【一覧】年収の壁は7つある（2026年・令和8年）",
          "id": "ichiran"
        },
        {
          "text": "税金の壁は、社会保険ほど大きな段差はないが、小幅な手取り減はあり得る",
          "id": "zeikin"
        },
        {
          "text": "【実数】年収129万円と131万円で、手取りはいくら違うか",
          "id": "gyakuten"
        },
        {
          "text": "106万円と130万円は「誰の話か」が違う",
          "id": "dare"
        },
        {
          "text": "【重要】月8.8万円以上の賃金要件は2026年10月に撤廃",
          "id": "kakudai"
        },
        {
          "text": "130万円は「実績」ではなく「見込み」で判定される",
          "id": "mikomi"
        },
        {
          "text": "社会保険に入るのは、損とは限らない",
          "id": "son"
        },
        {
          "text": "よくある質問",
          "id": "faq"
        },
        {
          "text": "関連記事・ツール",
