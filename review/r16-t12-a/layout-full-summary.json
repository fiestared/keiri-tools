    {
      "url": "/column/shunyu-inshi-warihan/",
      "width": 1280,
      "height": 900,
      "issues": [
        {
          "kind": "svg-rect",
          "tag": "text",
          "id": "",
          "text": "必要額を貼付・消印して納付完了",
          "bounds": {
            "x": 492.8890075683594,
            "y": 62.54167175292969,
            "right": 687.1110229492188,
            "bottom": 75.07900142669678
          },
          "rect": {
            "x": 500,
            "y": 52,
            "right": 680,
            "bottom": 86
          },
          "svg": 1
        }
      ],
      "headings": [
        {
          "text": "結論：条文にあるのは「印紙を消す」だけ",
          "id": "ketsuron"
        },
        {
          "text": "条文はどう書いてあるか（法8条2項）",
          "id": "joubun"
        },
        {
          "text": "誰の印章で消すのか — 代表者印でなくてよい",
          "id": "dare"
        },
        {
          "text": "割印・契印・消印はどう違うか",
          "id": "chigai"
        },
        {
          "text": "消し忘れは額面相当、過怠税の合計最低1,000円",
          "id": "keshiwasure"
        },
        {
          "text": "貼り忘れは3倍・合計最低1,000円、決定を予知しない申出なら1.1倍",
          "id": "hariwasure"
        },
        {
          "text": "過怠税は損金にも必要経費にもならない",
          "id": "sonkin"
        },
        {
          "text": "貼りすぎたときの還付と、郵便局での交換",
          "id": "kanpu"
        },
        {
          "text": "間違えやすい点",
          "id": "otoshiana"
        },
        {
          "text": "よくある質問",
          "id": "faq"
        },
        {
          "text": "次に読む",
          "id": ""
        },
        {
          "text": "関連記事・ツール",
          "id": ""
        },
        {
          "text": "出典",
          "id": ""
        }
      ],
