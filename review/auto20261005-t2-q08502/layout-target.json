    "headings": [
      {
        "text": "まず確認する、上段の4つの数字",
        "id": "yotsu"
      },
      {
        "text": "年末調整済みの4つの数字の計算の流れ（図解）",
        "id": "nagare"
      },
      {
        "text": "「給与所得控除後の金額」と「所得控除の額の合計額」を検算する",
        "id": "kensan"
      },
      {
        "text": "③と入力した控除額を比較する（差額は控除の特定ではありません）",
        "id": "kensan-tool"
      },
      {
        "text": "欄ごとの意味・早見表",
        "id": "ran"
      },
      {
        "text": "実務での使いどころ（年収の証明・確定申告・転職）",
        "id": "tsukaimichi"
      },
      {
        "text": "いつもらえる？なくした・もらえないときは（交付時期と再発行）",
        "id": "itsu"
      },
      {
        "text": "よくある勘違いと落とし穴",
        "id": "otoshiana"
      },
      {
        "text": "令和8年分の源泉徴収票の数字はここが変わる",
        "id": "kaisei"
