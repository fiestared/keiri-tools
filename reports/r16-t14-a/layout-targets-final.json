    "headings": [
      {
        "text": "令和9年分の月額表（全228区分）",
        "id": "table"
      },
      {
        "text": "令和8年分から変わった3点",
        "id": "changes"
      },
      {
        "text": "防衛特別所得税が加わっても、天引きの合計は増えない",
        "id": "boei"
      },
      {
        "text": "源泉徴収が発生しないラインが111,000円未満へ上がった",
        "id": "threshold"
      },
      {
        "text": "同じ給与額で引いた新旧の税額",
        "id": "compare"
      },
      {
        "text": "740,000円を超えるときは表ではなく算式で計算する",
        "id": "over740"
      },
      {
        "text": "表の引き方（当てはめるのは総支給額ではない）",
        "id": "howto"
      },
      {
        "text": "次に読む",
        "id": ""
      },
      {
        "text": "よくある質問",
        "id": "faq"
      },
