{"attached_files_info":null,"law_info":{"law_type":"Act","law_id":"344AC0000000084","law_num":"昭和四十四年法律第八十四号","law_num_era":"Showa","law_num_year":44,"law_num_type":"Act","law_num_num":"084","promulgation_date":"1969-12-09"},"revision_info":{"law_revision_id":"344AC0000000084_20251001_506AC0000000026","law_type":"Act","law_title":"労働保険の保険料の徴収等に関する法律","law_title_kana":"ろうどうほけんのほけんりょうのちょうしゅうとうにかんするほうりつ","abbrev":"労働保険徴収法","category":"労働","updated":"2024-07-23T04:04:12+09:00","amendment_promulgate_date":"2024-05-17","amendment_enforcement_date":"2025-10-01","amendment_enforcement_comment":null,"amendment_scheduled_enforcement_date":null,"amendment_law_id":"506AC0000000026","amendment_law_title":"雇用保険法等の一部を改正する法律","amendment_law_title_kana":null,"amendment_law_num":"令和六年法律第二十六号","amendment_type":"3","repeal_status":"None","repeal_date":null,"remain_in_force":false,"mission":"New","current_revision_status":"CurrentEnforced"},"law_full_text":{"tag":"Article","attr":{"Num":"11"},"children":[{"tag":"ArticleCaption","attr":{},"children":["（一般保険料の額）"]},{"tag":"ArticleTitle","attr":{},"children":["第十一条"]},{"tag":"Paragraph","attr":{"Num":"1"},"children":[{"tag":"ParagraphNum","attr":{},"children":[]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["一般保険料の額は、賃金総額に次条の規定による一般保険料に係る保険料率を乗じて得た額とする。"]}]}]},{"tag":"Paragraph","attr":{"Num":"2"},"children":[{"tag":"ParagraphNum","attr":{},"children":["２"]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["前項の「賃金総額」とは、事業主がその事業に使用するすべての労働者に支払う賃金の総額をいう。"]}]}]},{"tag":"Paragraph","attr":{"Num":"3"},"children":[{"tag":"ParagraphNum","attr":{},"children":["３"]},{"tag":"ParagraphSentence","attr":{},"children":[{"tag":"Sentence","attr":{"Num":"1","WritingMode":"vertical"},"children":["前項の規定にかかわらず、厚生労働省令で定める事業については、厚生労働省令で定めるところにより算定した額を当該事業に係る賃金総額とする。"]}]}]}]}}