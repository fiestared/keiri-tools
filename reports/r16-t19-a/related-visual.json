  {
    "name": "tosan-boshi-kyosai",
    "width": 1280,
    "issues": [],
    "headings": [
      {
        "text": "使い方と前提",
        "id": "tsukaikata"
      },
      {
        "text": "そもそも何の制度か — 掛金の10倍まで無利子で借りられる",
        "id": "shikumi"
      },
      {
        "text": "掛金は「必要経費」— 所得控除とはここが違う",
        "id": "keihi"
