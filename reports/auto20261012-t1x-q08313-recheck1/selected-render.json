[
  {
    "url": "/column/gensen-shotokuzei-nofusho/",
    "width": 1280,
    "height": 900,
    "issues": [],
    "headings": [
      {
        "text": "用紙は10種類。給与用は「一般用」と「納期特例分」で別",
        "id": "shurui"
      },
      {
        "text": "「人員」の数え方は欄ごとに違う",
        "id": "ran"
      },
      {
        "text": "納期限 — 土曜日は法律ではなく政令が足している",
        "id": "kigen"
      },
      {
        "text": "納付税額0円のときの提出対象と提出先",
        "id": "zero"
      },
      {
        "text": "遅れたとき — 不納付加算税がゼロになる条件",
        "id": "okure"
      },
      {
        "text": "令和8年9月下旬以降の税務署窓口配付分の様式変更予定",
        "id": "kaisei"
      },
      {
        "text": "「税理士等の報酬」欄の21士業は、法律12＋政令9",
        "id": "shigyo"
      },
      {
        "text": "納付書と計算書は、法令上べつの書類が1枚になったもの",
        "id": "kozo"
      },
      {
        "text": "よくある質問",
        "id": "faq"
      },
      {
        "text": "次に読む",
        "id": ""
      },
      {
        "text": "出典",
        "id": "shutten"
      }
    ],
